   "source": [
    "plt.rcParams.update({'font.size': 16}) \n",
    "# To set the font size for axis labels\n",
    "plt.rcParams['axes.labelsize'] = 18 \n",
    "# To set the font size for tick labels (the numbers on the axes)\n",
