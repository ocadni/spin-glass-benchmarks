#!/bin/bash
#PBS -S /bin/bash
#PBS -q workq-longrun
#PBS -N greedy_SK
#PBS -V
#PBS -l select=1:ncpus=1
#PBS -o /dev/null
#PBS -e /dev/null

set -euo pipefail

module purge
source ~/miniconda3/etc/profile.d/conda.sh
conda activate new

cd "$PBS_O_WORKDIR"

SCRIPT_DIR="$PBS_O_WORKDIR"
JOB_ID="${PBS_JOBID:-$$}"

# PBS -o/-e above are discarded (/dev/null). Each job writes its own log and
# results part-files below (no file is ever touched by more than one job at
# once), so there's no concurrent-append race. Run merge_results.sh afterward
# to combine all jobs' parts into the final results_*.txt / run_greedy_sk_dariah.out/.err.
RESULTS_PARTS_DIR="$SCRIPT_DIR/results_parts"
LOGS_PARTS_DIR="$SCRIPT_DIR/logs_parts"
mkdir -p "$RESULTS_PARTS_DIR" "$LOGS_PARTS_DIR"

exec >>"$LOGS_PARTS_DIR/stdout_${JOB_ID}.log"
exec 2>>"$LOGS_PARTS_DIR/stderr_${JOB_ID}.log"

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1
export NUMEXPR_NUM_THREADS=1

REPO_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"

SOURCE="$SCRIPT_DIR/greedy.c"
BINARY="${GREEDY_BIN:-$SCRIPT_DIR/greedy}"
INSTANCES_ROOT="${INSTANCES_ROOT:-$REPO_ROOT/instances/sk}"

POP_SIZE="${POP_SIZE:-1}"
SWEEPS="${SWEEPS:-100000000}"
ZERO_FIELDS="${ZERO_FIELDS:-false}"
MAX_INSTANCES_PER_N="${MAX_INSTANCES_PER_N:-100}"

N_REPEATS="${N_REPEATS:-10}"

MODES=(greedy random reluctant)

RUN_SEED="${RUN_SEED:-}"
MAX_RUN_SEED=2147483647

random_run_seed() {
    local raw
    raw="$(od -An -N4 -tu4 /dev/urandom | tr -d '[:space:]')"
    echo $((raw % (MAX_RUN_SEED + 1)))
}

validate_run_seed() {
    local seed="$1"

    if ! [[ "$seed" =~ ^[0-9]+$ ]]; then
        echo "error: RUN_SEED must be an integer between 0 and $MAX_RUN_SEED" >&2
        exit 1
    fi

    if [ "$seed" -gt "$MAX_RUN_SEED" ]; then
        echo "error: RUN_SEED must be between 0 and $MAX_RUN_SEED" >&2
        exit 1
    fi
}

if [ -n "$RUN_SEED" ]; then
    validate_run_seed "$RUN_SEED"
fi

if [ -z "${N_VALUES:-}" ]; then
    echo "error: N_VALUES was not provided" >&2
    exit 1
fi

if [ ! -x "$BINARY" ] || [ "$SOURCE" -nt "$BINARY" ]; then
    cc -O3 -std=c11 "$SOURCE" -lm -o "$BINARY"
fi

echo "=== job ${PBS_JOBID:-unknown} on $(hostname) starting $(date) ==="
echo "N values: $N_VALUES"
echo "POP_SIZE: $POP_SIZE"
echo "SWEEPS: $SWEEPS"
echo "ZERO_FIELDS: $ZERO_FIELDS"
echo "Repeats: $N_REPEATS"
echo "Modes: ${MODES[*]}"

for MODE in "${MODES[@]}"; do

    RESULTS_FILE="$RESULTS_PARTS_DIR/results_${MODE}_${JOB_ID}.txt"

    echo "========================================"
    echo "MODE=$MODE"
    echo "Results: $RESULTS_FILE"
    echo "========================================"

    for repeat in $(seq 1 "$N_REPEATS"); do

        echo "Mode=$MODE repeat=$repeat/$N_REPEATS"

        for N in $N_VALUES; do

            echo "Running mode=$MODE repeat=$repeat N=$N"

            instance_dir="$INSTANCES_ROOT/N$N"

            if [ ! -d "$instance_dir" ]; then
                echo "warning: missing instance directory: $instance_dir" >&2
                continue
            fi

            counter=0

            for instance in "$instance_dir"/sk_couplings_N"${N}"_J0_seed*.txt; do

                if [ ! -f "$instance" ]; then
                    continue
                fi

                filename="$(basename "$instance")"

                instance_seed="${filename##*seed}"
                instance_seed="${instance_seed%.txt}"

                current_run_seed="$RUN_SEED"

                if [ -z "$current_run_seed" ]; then
                    current_run_seed="$(random_run_seed)"
                fi

                result_row="$("$BINARY" "$instance" \
                    --num-spins "$N" \
                    --pop-size "$POP_SIZE" \
                    --sweeps "$SWEEPS" \
                    --mode "$MODE" \
                    --zero_fields "$ZERO_FIELDS" \
                    --seed "$current_run_seed" \
                    --instance-seed "$instance_seed")"

                printf "%s %s\n" "$repeat" "$result_row" >> "$RESULTS_FILE"

                counter=$((counter + 1))

                if [ "$counter" -ge "$MAX_INSTANCES_PER_N" ]; then
                    break
                fi

            done

            if [ "$counter" -eq 0 ]; then
                echo "warning: no matching SK instances found for N=$N in $instance_dir" >&2
            fi

        done
    done
done

echo "=== job ${PBS_JOBID:-unknown} finished $(date) ==="
